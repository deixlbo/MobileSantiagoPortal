# Supabase connection variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Use one of these for server-side operations:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# or
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional app URL override for links generated by the API
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional QR signature secret for QR generation
QR_SIGNATURE_SECRET=your-qr-secret
